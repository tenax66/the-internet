---
/**
 * 16x16 のドット絵アイコン。Win95 のシステムアイコン風。
 * viewBox は 16x16 固定で、大きさは CSS（width/height）側で決める。
 */
import type { IconName } from "../utils/icons";

interface Props {
	name: IconName;
	size?: number;
	class?: string;
	title?: string;
}

const { name, size = 16, class: className, title } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 16 16"
	shape-rendering="crispEdges"
	role={title ? "img" : "presentation"}
	aria-label={title}
	aria-hidden={title ? undefined : "true"}
	focusable="false"
>
	{
		name === "document" && (
			<g>
				<path d="M2 1h8l4 4v10H2z" fill="#fff" stroke="#000" stroke-width="1" />
				<path d="M10 1v4h4" fill="#c0c0c0" stroke="#000" />
				<path d="M4 7h6M4 9h6M4 11h4" stroke="#000080" />
			</g>
		)
	}
	{
		name === "paint" && (
			<g>
				<rect x="1" y="2" width="14" height="12" fill="#fff" stroke="#000" />
				<rect x="2" y="3" width="12" height="5" fill="#000080" />
				<rect x="10" y="4" width="3" height="3" fill="#ffe08a" />
				<rect x="2" y="8" width="12" height="2" fill="#1084d0" />
				<rect x="2" y="10" width="12" height="3" fill="#808080" />
				<rect x="4" y="11" width="4" height="2" fill="#c81e1e" />
			</g>
		)
	}
	{
		name === "browser" && (
			<g>
				<circle cx="8" cy="8" r="6" fill="#1084d0" stroke="#000" />
				<path d="M2 8h12M8 2c3 3 3 9 0 12M8 2c-3 3-3 9 0 12" stroke="#fff" fill="none" />
			</g>
		)
	}
	{
		name === "folder" && (
			<g>
				<path d="M1 3h5l2 2h7v9H1z" fill="#ffd75e" stroke="#000" />
				<path d="M2 6h12v7H2z" fill="#ffe89a" />
			</g>
		)
	}
	{
		name === "folder-open" && (
			<g>
				<path d="M1 3h5l2 2h5v3H1z" fill="#ffd75e" stroke="#000" />
				<path d="M1 8h13l-2 6H1z" fill="#ffe89a" stroke="#000" />
			</g>
		)
	}
	{
		name === "computer" && (
			<g>
				<rect x="1" y="2" width="14" height="9" fill="#c0c0c0" stroke="#000" />
				<rect x="3" y="4" width="10" height="5" fill="#1084d0" />
				<path d="M5 11h6l1 3H4z" fill="#c0c0c0" stroke="#000" />
			</g>
		)
	}
	{
		name === "search" && (
			<g fill="none" stroke="#000" stroke-width="1.5">
				<circle cx="7" cy="7" r="4" fill="#fff" />
				<path d="M10 10l4 4" />
			</g>
		)
	}
	{
		name === "home" && (
			<g>
				<path d="M8 2l6 6h-2v6H4V8H2z" fill="#ffd75e" stroke="#000" />
				<rect x="6" y="10" width="4" height="4" fill="#000080" />
			</g>
		)
	}
	{
		name === "back" && <path d="M10 3L5 8l5 5z" fill="#1a7a1a" stroke="#000" />
	}
	{
		name === "forward" && <path d="M6 3l5 5-5 5z" fill="#1a7a1a" stroke="#000" />
	}
	{
		name === "stop" && (
			<g>
				<circle cx="8" cy="8" r="6" fill="#c81e1e" stroke="#000" />
				<rect x="4" y="7" width="8" height="2" fill="#fff" />
			</g>
		)
	}
	{
		name === "reload" && (
			<g fill="none" stroke="#1a7a1a" stroke-width="2">
				<path d="M12 8a4 4 0 1 1-2-3.5" />
				<path d="M13 2v4h-4" stroke-width="1.5" />
			</g>
		)
	}
	{
		name === "print" && (
			<g>
				<rect x="4" y="2" width="8" height="4" fill="#fff" stroke="#000" />
				<rect x="1" y="6" width="14" height="5" fill="#c0c0c0" stroke="#000" />
				<rect x="4" y="10" width="8" height="4" fill="#fff" stroke="#000" />
			</g>
		)
	}
	{
		name === "tag" && (
			<g>
				<path d="M8 1h6v6l-7 7-6-6z" fill="#ffd75e" stroke="#000" />
				<circle cx="11" cy="4" r="1.5" fill="#fff" stroke="#000" />
			</g>
		)
	}
	{
		name === "star" && (
			<path
				d="M8 1l2 5h5l-4 3 1.5 5L8 11l-4.5 3L5 9 1 6h5z"
				fill="#ffd75e"
				stroke="#000"
			/>
		)
	}
	{
		name === "settings" && (
			<g>
				<rect x="1" y="3" width="14" height="10" fill="#c0c0c0" stroke="#000" />
				<path d="M3 6h10M3 10h10" stroke="#808080" />
				<rect x="5" y="4" width="3" height="4" fill="#000080" stroke="#000" />
				<rect x="9" y="8" width="3" height="4" fill="#c81e1e" stroke="#000" />
			</g>
		)
	}
	{
		name === "notepad" && (
			<g>
				<rect x="2" y="1" width="12" height="14" fill="#fff" stroke="#000" />
				<rect x="3" y="2" width="10" height="2" fill="#000080" />
				<path d="M4 6h8M4 8h8M4 10h6M4 12h4" stroke="#808080" />
			</g>
		)
	}
	{
		name === "media" && (
			<g>
				<rect x="1" y="2" width="14" height="12" fill="#c0c0c0" stroke="#000" />
				<rect x="2" y="3" width="12" height="7" fill="#000" />
				<path d="M6 4.5l4 2-4 2z" fill="#3ba03b" />
				<rect x="2" y="11" width="8" height="2" fill="#000080" />
			</g>
		)
	}
	{
		name === "world" && (
			<g>
				<circle cx="8" cy="8" r="6.5" fill="#3ba03b" stroke="#000" />
				<path
					d="M1.5 8h13M8 1.5c2.5 2.5 2.5 10.5 0 13M8 1.5c-2.5 2.5-2.5 10.5 0 13"
					stroke="#0a4d0a"
					fill="none"
				/>
				<path d="M4 4l2 1-1 2 2 1" stroke="#fff" fill="none" />
			</g>
		)
	}
	{
		name === "warning" && (
			<g>
				<path d="M8 1l7 13H1z" fill="#ffd75e" stroke="#000" />
				<rect x="7" y="6" width="2" height="4" fill="#000" />
				<rect x="7" y="11" width="2" height="2" fill="#000" />
			</g>
		)
	}
	{
		name === "network" && (
			<g>
				<rect x="1" y="1" width="8" height="6" fill="#c0c0c0" stroke="#000" />
				<rect x="2" y="2" width="6" height="4" fill="#1084d0" />
				<rect x="7" y="9" width="8" height="6" fill="#c0c0c0" stroke="#000" />
				<rect x="8" y="10" width="6" height="4" fill="#1084d0" />
				<path d="M5 7v3h5" stroke="#000" fill="none" />
			</g>
		)
	}
	{
		name === "chip" && (
			<g>
				<rect x="3" y="3" width="10" height="10" fill="#1a1a1a" stroke="#000" />
				<rect x="5" y="5" width="6" height="6" fill="#3ba03b" />
				<path
					d="M5 1v2M8 1v2M11 1v2M5 13v2M8 13v2M11 13v2M1 5h2M1 8h2M1 11h2M13 5h2M13 8h2M13 11h2"
					stroke="#808080"
				/>
			</g>
		)
	}
	{
		name === "dos" && (
			<g>
				<rect x="1" y="2" width="14" height="12" fill="#000" stroke="#000" />
				<rect x="1" y="2" width="14" height="2" fill="#c0c0c0" />
				<path d="M3 7l2 2-2 2" fill="none" stroke="#fff" />
				<rect x="6" y="10" width="4" height="1" fill="#fff" />
			</g>
		)
	}
	{
		name === "cards" && (
			<g>
				<rect x="1" y="4" width="8" height="11" fill="#1e64c8" stroke="#000" />
				<path d="M2 5h6v9H2z" fill="#6ea8f0" />
				<rect x="7" y="1" width="8" height="11" fill="#fff" stroke="#000" />
				<path d="M11 4l2 2-2 2-2-2z" fill="#c81e1e" />
			</g>
		)
	}
	{
		name === "mail" && (
			<g>
				<rect x="1" y="3" width="14" height="10" fill="#fff" stroke="#000" />
				<path d="M1 3l7 6 7-6" fill="none" stroke="#000" />
			</g>
		)
	}
</svg>
