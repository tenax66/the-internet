---
import LiveSearch from "emdash/ui/search";
import Icon from "./Icon.astro";
import type { IconName } from "../utils/icons";

interface NavItem {
	label: string;
	url: string;
	icon: IconName;
	target?: string | null;
}

interface Props {
	/** 上部バーに並べるナビ。Base.astro が組み立てて渡す */
	navItems?: NavItem[];
	/** 現在のパス。現在地のボタンを押し込み表示にするのに使う */
	currentPath?: string;
	/** スタートメニュー左端の縦帯に出す文字 */
	railTitle?: string;
	/** トップページかどうか。ウィンドウ操作の項目はトップでだけ出す */
	showWindowActions?: boolean;
}

const {
	navItems = [],
	currentPath = "/",
	railTitle = "MENU",
	showWindowActions = false,
} = Astro.props;

const normalize = (url: string) => url.replace(/\/$/, "") || "/";
const isCurrent = (url: string) => normalize(url) === currentPath;
---

<nav class="startmenu" id="startmenu" hidden aria-label="スタートメニュー">
	<div class="startmenu-rail" aria-hidden="true">
		<span>{railTitle}</span>
	</div>

	<ul class="startmenu-list">
		{
			navItems.map((item) => (
				<li>
					<a
						href={item.url}
						target={item.target ?? undefined}
						aria-current={isCurrent(item.url) ? "page" : undefined}
					>
						<Icon name={item.icon} size={20} />
						{item.label}
					</a>
				</li>
			))
		}

		{
			showWindowActions && (
				<>
					<li class="startmenu-divider" role="separator" />
					<li>
						<a href="#" data-window-action="restore-all">
							<Icon name="computer" size={20} />
							閉じたウィンドウを開き直す
						</a>
					</li>
				</>
			)
		}

		<li class="startmenu-divider" role="separator"></li>

		<li class="startmenu-search">
			<LiveSearch placeholder="検索..." collections={["posts", "pages"]} />
		</li>
	</ul>
</nav>

{/*
 * 画面上部のバー。見た目は Win95 のタスクバーだが、並ぶのは開いている窓では
 * なくサイトのセクションで、押すとそのページへ移動する。現在地のボタンだけが
 * 押し込まれた状態になる。
 */}
<div class="taskbar">
	<button
		type="button"
		class="taskbar-start"
		id="start-button"
		aria-expanded="false"
		aria-controls="startmenu"
	>
		<svg width="16" height="16" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
			<rect x="1" y="2" width="9" height="8" fill="#c0c0c0" stroke="#000"></rect>
			<rect x="2" y="3" width="7" height="2" fill="#808080"></rect>
			<rect x="6" y="6" width="9" height="8" fill="#dfdfdf" stroke="#000"></rect>
			<rect x="7" y="7" width="7" height="2" fill="#000080"></rect>
		</svg>
		<span>スタート</span>
	</button>

	<div class="taskbar-sep" aria-hidden="true"></div>

	<nav class="taskbar-items" aria-label="サイト内ナビゲーション">
		{
			navItems.map((item) => (
				<a
					class:list={["taskbar-item", isCurrent(item.url) && "is-active"]}
					href={item.url}
					target={item.target ?? undefined}
					title={item.label}
					aria-current={isCurrent(item.url) ? "page" : undefined}
				>
					<Icon name={item.icon} size={14} />
					<span>{item.label}</span>
				</a>
			))
		}
	</nav>

	<div class="taskbar-tray">
		<span id="taskbar-clock" aria-label="現在時刻">--:--</span>
	</div>
</div>
