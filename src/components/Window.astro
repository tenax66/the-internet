---
import Icon from "./Icon.astro";
import type { IconName } from "../utils/icons";

/**
 * Win95 風のウィンドウ枠。
 *
 * 「ファイル(F) 編集(E)」のメニュー行やアドレスバーは置かない。窓は
 * タイトルバー + 中身（+ 任意でステータスバー）だけのシンプルな構成にして、
 * ナビゲーションは画面上部のバーに一本化している。
 *
 * スロット:
 *   default  クライアント領域の中身
 *   status   ステータスバーのセル（<span> を並べる。1 つ目が左寄せで伸びる）
 */
interface Props {
	/** タスクバーのボタンと結びつく ID */
	id: string;
	title: string;
	icon?: IconName;
	/** × ボタンを出すか（false なら無効表示） */
	closable?: boolean;
	/** クライアント領域に足すクラス。win-body-face でグレー地にできる */
	bodyClass?: string;
	class?: string;
	/**
	 * デスクトップのグリッドで占める大きさ。
	 *   col  横に何カラム分か（1 or 2）
	 *   row  縦に何行分か。1 行 = --w-row（8px）なので row=30 で 240px
	 * 640px 未満では無視され、中身なりの高さで 2 列の段組みに流し込まれる。
	 */
	col?: 1 | 2;
	row?: number;
	/**
	 * true にすると割り当てられたマスいっぱいには広がらず、中身なりの高さで止まる。
	 * ダイアログ系（中身の高さが決まっている窓）用。余ったマスは背景が見える。
	 * 一覧や本文のように中身が伸び縮みする窓では使わないこと（下の窓と重なる）。
	 */
	fit?: boolean;
}

const {
	id,
	title,
	icon = "document",
	closable = true,
	bodyClass,
	class: className,
	col,
	row,
	fit = false,
} = Astro.props;

/** グリッドの span は CSS 変数で渡す。指定が無ければ CSS 側の既定値が効く */
const spanStyle = [
	col ? `--win-col:${col}` : null,
	row ? `--win-row:${row}` : null,
]
	.filter(Boolean)
	.join(";");
---

<section
	class:list={["win", fit && "win-fit", className]}
	style={spanStyle || undefined}
	data-window={id}
	data-window-title={title}
	aria-label={title}
>
	<div class="win-titlebar">
		<Icon name={icon} class="win-titlebar-icon" />
		<span class="win-titlebar-text">{title}</span>
		<div class="win-controls">
			<button
				type="button"
				class="win-ctl"
				data-window-action="close"
				disabled={!closable}
				title="閉じる"
			>
				<span aria-hidden="true">✕</span>
				<span class="visually-hidden">閉じる</span>
			</button>
		</div>
	</div>

	<div class:list={["win-body", bodyClass]}>
		<slot />
	</div>

	{
		Astro.slots.has("status") && (
			<div class="win-status">
				<slot name="status" />
			</div>
		)
	}
</section>
