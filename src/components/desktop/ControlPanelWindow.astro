---
import Window from "../Window.astro";
import Icon from "../Icon.astro";

/**
 * 「コントロール パネル」風のタグ一覧窓。
 * 設定項目のかわりにタグをアイコンで並べる。
 */

interface Term {
	slug: string;
	label: string;
	count?: number;
}

interface Props {
	tags: Term[];
	col?: 1 | 2;
	row?: number;
}

const { tags, col = 1, row = 30 } = Astro.props;
---

<Window
	id="control"
	class="area-control"
	icon="settings"
	title="コントロール パネル"
	bodyClass="win-body-flush"
	col={col}
	row={row}
>
	<div class="win-menubar" slot="menubar">
		<span>ファイル(<span class="key">F</span>)</span>
		<span>編集(<span class="key">E</span>)</span>
		<span>ヘルプ(<span class="key">H</span>)</span>
	</div>

	{
		tags.length === 0 ? (
			<p class="listview-empty">タグがまだありません。</p>
		) : (
			<div class="iconview iconview-sm">
				{tags.map((t) => (
					<a class="iconview-item" href={`/tag/${t.slug}`}>
						<Icon name="tag" size={28} />
						<span class="iconview-label">{t.label}</span>
						{t.count != null && <span class="iconview-note">{t.count}</span>}
					</a>
				))}
			</div>
		)
	}

	<Fragment slot="status">
		<span>タグを選ぶと、そのタグの記事だけを表示します</span>
		<span>{tags.length} 個</span>
	</Fragment>
</Window>
