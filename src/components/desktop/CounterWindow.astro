---
import Window from "../Window.astro";

/**
 * 昔の個人サイトのアクセスカウンター風の飾り窓。
 * ただし嘘の訪問者数は出さず、実際の記事数をオドメーターで表示する。
 */

interface Props {
	postCount: number;
	col?: 1 | 2;
	row?: number;
}

const { postCount, col = 1, row = 16 } = Astro.props;

/** 000012 のように 6 桁ゼロ埋めして 1 桁ずつ描く */
const digits = String(postCount).padStart(6, "0").split("");
---

<Window
	id="counter"
	class="area-counter"
	icon="warning"
	title="工事中"
	bodyClass="win-body-face"
	col={col}
	row={row}
	fit
>
	<div class="counter">
		<div class="counter-stripe" aria-hidden="true"></div>

		<p class="counter-label">このサイトには</p>
		<p class="counter-digits" aria-hidden="true">
			{digits.map((d) => <span class="counter-digit">{d}</span>)}
		</p>
		<p class="counter-label">
			<span class="visually-hidden">{postCount}</span> 本の記事があります
		</p>

		<div class="counter-stripe" aria-hidden="true"></div>
	</div>
</Window>
