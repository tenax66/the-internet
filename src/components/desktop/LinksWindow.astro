---
import Window from "../Window.astro";
import Icon from "../Icon.astro";

/**
 * 「お気に入り」風の外部リンク集。
 * 出したいリンクは index.astro 側から links プロパティで渡す。
 */

interface Link {
	label: string;
	url: string;
	note?: string;
}

interface Props {
	links: Link[];
	col?: 1 | 2;
	row?: number;
}

const { links, col = 1, row = 24 } = Astro.props;
---

<Window
	id="links"
	class="area-links"
	icon="world"
	title="お気に入り"
	bodyClass="win-body-flush"
	col={col}
	row={row}
>
	{
		links.length === 0 ? (
			<p class="listview-empty">リンクがまだありません。</p>
		) : (
			<div class="listview">
				{links.map((l) => (
					<a
						class="listview-row listview-row-2col"
						href={l.url}
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="world" class="listview-icon" />
						<span class="listview-name">{l.label}</span>
						<span class="listview-meta">{l.note ?? "↗"}</span>
					</a>
				))}
			</div>
		)
	}
</Window>
