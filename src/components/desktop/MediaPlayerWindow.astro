---
import Window from "../Window.astro";
import MediaPlayer from "../widgets/MediaPlayer.astro";
interface Props { col?: 1 | 2; row?: number; }
const { col = 1, row = 24 } = Astro.props;
---

<Window id="player" class="area-player" icon="media" title="メディア プレーヤー" bodyClass="win-body-face" col={col} row={row} fit>
	<MediaPlayer />
</Window>
