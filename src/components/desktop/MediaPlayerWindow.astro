---
import Window from "../Window.astro";

/**
 * 「メディア プレーヤー」風の飾り窓。再生はしない。
 * 横長で背が低いので、グリッドの隙間を埋めて大きさの変化を作る役。
 */

interface Props {
	nowPlaying?: string;
	artist?: string;
	col?: 1 | 2;
	row?: number;
}

const {
	nowPlaying = "dial-up handshake",
	artist = "56k modem",
	col = 1,
	row = 20,
} = Astro.props;

/** イコライザの棒。高さと遅れをずらして機械的に見えないようにする */
const bars = [40, 72, 55, 88, 30, 64, 46, 80, 36, 60, 92, 50];
---

<Window
	id="player"
	class="area-player"
	icon="media"
	title="メディア プレーヤー"
	bodyClass="win-body-face"
	col={col}
	row={row}
	fit
>
	<div class="player">
		<div class="player-screen" aria-hidden="true">
			<div class="player-eq">
				{
					bars.map((h, i) => (
						<span style={`--h:${h}%;--i:${i}`} />
					))
				}
			</div>
			<p class="player-track">
				♪ {nowPlaying} — {artist}
			</p>
		</div>

		<div class="player-seek sunken" aria-hidden="true">
			<span class="player-thumb"></span>
		</div>

		<div class="player-transport" aria-hidden="true">
			<span class="player-btn">◀◀</span>
			<span class="player-btn">▶</span>
			<span class="player-btn">■</span>
			<span class="player-btn">▶▶</span>
			<span class="player-time">00:28 / 03:14</span>
		</div>
	</div>
</Window>
