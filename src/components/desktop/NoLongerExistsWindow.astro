---
import Window from "../Window.astro";

interface Props {
 message?: string;
 col?: 1 | 2;
 row?: number;
}
const { message = "no longer exists", col = 1, row = 24 } = Astro.props;
---

<Window
 id="nolongerexists"
 class="area-nolongerexists"
 title="The world you were born in"
 icon="warning"
 bodyClass="win-body-face"
 col={col}
 row={row}
>
 <div class="world-dialog">
  <p>{message}</p>
  <button type="button" class="btn" data-window-action="close">OK</button>
 </div>
</Window>

<style>
 .world-dialog {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  gap: 16px;
  padding: 12px 0;
 }
 .world-dialog p { margin: 0; font-size: 14px; font-weight: 700; text-align: center; }
 .world-dialog .btn { min-width: 75px; }
</style>
