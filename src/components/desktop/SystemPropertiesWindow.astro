---
import Window from "../Window.astro";
import Icon from "../Icon.astro";

/**
 * 「システムのプロパティ」風のプロフィール窓。
 * 中身は本物のサイト情報（記事数・最終更新）＋世界観のためのスペック表記。
 */

interface Props {
	siteTitle: string;
	siteTagline: string;
	postCount: number;
	pageCount: number;
	tagCount: number;
	lastUpdated?: Date | null;
	col?: 1 | 2;
	row?: number;
}

const {
	siteTitle,
	siteTagline,
	postCount,
	pageCount,
	tagCount,
	lastUpdated,
	col = 1,
	row = 38,
} = Astro.props;

const dateFormat = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
---

<Window
	id="sysprop"
	class="area-sysprop"
	icon="chip"
	title="システムのプロパティ"
	bodyClass="win-body-face"
	col={col}
	row={row}
	fit
>
	<div class="tabs" role="presentation">
		<span class="tab is-active">全般</span>
		<span class="tab">デバイス マネージャ</span>
	</div>

	<div class="tabpanel">
		<div class="sysprop">
			<Icon name="chip" size={40} class="sysprop-icon" />

			<dl class="sysprop-list">
				<dt>システム:</dt>
				<dd>
					{siteTitle}<br />
					<span class="muted">{siteTagline}</span>
				</dd>

				<dt>使用者:</dt>
				<dd>あなた<br /><span class="muted">Web Browser 4.0</span></dd>

				<dt>コンピュータ:</dt>
				<dd>
					記事 {postCount} 本 / ページ {pageCount} 枚<br />
					タグ {tagCount} 個
					{
						lastUpdated && (
							<>
								<br />
								最終更新 {dateFormat.format(lastUpdated)}
							</>
						)
					}
				</dd>
			</dl>
		</div>

		<div class="row dialog-actions">
			<a class="btn" href="/about">詳細…</a>
			<a class="btn" href="/posts">OK</a>
		</div>
	</div>
</Window>
