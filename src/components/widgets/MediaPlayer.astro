---
import Icon from "./HardwareIcon.astro";
---
<section class="house-player player" aria-label="メディアプレーヤー" data-media-player>
 <audio data-music preload="none" crossorigin="anonymous"></audio>
 <div class="player-screen">
  <div class="player-eq" data-spectrum aria-hidden="true">{Array.from({length:24}, () => <span style="--h:0%" />)}</div>
  <svg class="player-wave" viewBox="0 0 256 40" preserveAspectRatio="none" aria-hidden="true"><path data-waveform d="M0 20H256" /></svg>
  <p class="player-track" data-song-title>HOUSE RADIO</p>
 </div>
 <label class="track-picker">曲<select data-music-select aria-label="曲を選択">
  <option value="midnight">Midnight — Deep House</option>
  <option value="sunroom">Sunroom — Piano House</option>
  <option value="neon">Neon — Acid House</option>
 </select></label>
 <div class="device-controls">
  <button class="btn icon-button" data-music-play aria-label="再生" title="選択した曲を再生" aria-pressed="false"><Icon name="play" size={18} /></button>
  <button class="btn icon-button" data-music-stop aria-label="停止" title="停止"><Icon name="stop" size={18} /></button>
  <label class="icon-control" title="音量"><Icon name="volume" size={18} /><input data-volume aria-label="音量" type="range" min="0" max="1" step="0.01" value="0.35" /></label>
 </div>
 <span class="player-status visually-hidden" data-music-status role="status">曲を選んで再生してください</span>
</section>
<script>import "../../scripts/media-player";</script>
