---
import Icon from "./HardwareIcon.astro";
interface Props { headlines: string[] }
const { headlines } = Astro.props;
---
<section class="television device" aria-label="テレビ" data-television data-headlines={JSON.stringify(headlines)}>
	<div class="tv-bezel">
		<div class="tv-screen" data-screen>
			<img class="tv-footage" data-tv-image src="https://assets.internet.tanka.cc/broadcast/russian_monologue.gif" alt="ロシア語のモノローグ放送" />
			<div class="tv-off" hidden></div>
		</div>
	</div>
	<div class="device-controls">
		<button class="btn icon-button" data-power aria-label="電源" title="電源" aria-pressed="true"><Icon name="power" size={18} /></button>
		<span class="device-status visually-hidden" data-tv-status role="status">静止中</span>
	</div>
</section>
<script>import "../../scripts/television";</script>
