---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Taskbar from "../components/Taskbar.astro";
import Window from "../components/Window.astro";
import type { IconName } from "../utils/icons";
import {
	BROWSER_NAME,
	resolveStarterSiteIdentity,
} from "../utils/site-identity";
import "../styles/win98.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/**
	 * desktop = 中身を自分でウィンドウに分けて並べる（トップページだけ）
	 * window  = 中身を画面いっぱいの 1 枚のウィンドウで包む（記事・一覧など）
	 */
	chrome?: "desktop" | "window";
	/** chrome="window" のときタイトルバーに出す文字。既定は `title - ${BROWSER_NAME}` */
	windowTitle?: string;
	windowIcon?: IconName;
	/** ステータスバー左のテキスト */
	status?: string;
	/** ステータスバー右のテキスト */
	statusExtra?: string;
	/** 本文を読みやすい幅で中央寄せする（記事・固定ページ向け） */
	narrow?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	chrome = "window",
	windowTitle,
	windowIcon = "browser",
	status = "ページが表示されました",
	statusExtra = "インターネット",
	narrow = false,
} = Astro.props;

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

/*
 * 画面上部のバーに並べるナビ。
 * ブログの主要機能（ホーム / 記事一覧 / ページ一覧）は常に出し、そのうしろに
 * emdash の primary メニューで足された項目を並べる。URL が重なったものは省く。
 */
const normalizeUrl = (url: string) => url.replace(/\/$/, "") || "/";

const builtinNav: { label: string; url: string; icon: IconName }[] = [
	{ label: "ホーム", url: "/", icon: "home" },
	{ label: "記事一覧", url: "/posts", icon: "folder" },
	{ label: "ページ一覧", url: "/pages", icon: "document" },
];
const builtinUrls = new Set(builtinNav.map((i) => normalizeUrl(i.url)));

const menuItems = (menu?.items ?? [])
	.map((item) => ({
		label: item.label,
		url: item.url,
		target: item.target ?? null,
		icon: "browser" as IconName,
	}))
	.filter((item) => !builtinUrls.has(normalizeUrl(item.url)));

const navItems = [...builtinNav, ...menuItems];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const barTitle = windowTitle ?? `${title} - ${BROWSER_NAME}`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#008080" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<div class="desktop">
			{
				chrome === "desktop" ? (
					<slot />
				) : (
					<div class="desktop-single">
						{/*
						 * 下層ページは窓 1 枚。メニュー行もアドレスバーも持たず、
						 * 画面の上下左右いっぱいに広がる。
						 */}
						<Window
							id="page"
							class="win-page"
							title={barTitle}
							icon={windowIcon}
							closable={false}
						>
							<div class:list={["win-content", narrow && "win-content-narrow"]}>
								<slot />
							</div>

							<Fragment slot="status">
								<span>{status}</span>
								<span>{statusExtra}</span>
							</Fragment>
						</Window>
					</div>
				)
			}
		</div>

		<Taskbar
			navItems={navItems}
			currentPath={currentPath}
			railTitle={siteTitle}
			showWindowActions={chrome === "desktop"}
		/>

		<script>
			import "../scripts/desktop.ts";
		</script>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
