---
import { getEmDashEntry, getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import TeletextLogo from "../components/TeletextLogo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { formatServiceClock } from "../utils/service-clock";
import "../styles/teletext.css";
import "../styles/home-layout.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** トップの複数パネル、または下層の読み物レイアウト */
	layout?: "home" | "page";
	status?: string;
	/** 本文を読みやすい幅で中央寄せする（記事・固定ページ向け） */
	narrow?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	layout = "page",
	status = "",
	narrow = false,
} = Astro.props;

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const normalizeUrl = (url: string) => url.replace(/\/$/, "") || "/";
const menu = await getMenu("primary");
const { entry: about } = await getEmDashEntry("pages", "about");
const navItems: { label: string; url: string; number: string; target?: string | null }[] = [
	{ label: "INDEX", url: "/", number: "100" },
	{ label: "ARTICLES", url: "/posts", number: "200" },
	{ label: "GALLERY", url: "/gallery", number: "300" },
	{ label: "PAGES", url: "/pages", number: "500" },
];
if (about || menu?.items?.some((item) => normalizeUrl(item.url) === "/about")) {
	navItems.push({ label: "ABOUT", url: "/about", number: "501" });
}
const navUrls = new Set(navItems.map((item) => item.url));
for (const item of menu?.items ?? []) {
	const url = normalizeUrl(item.url);
	if (navUrls.has(url)) continue;
	navItems.push({ label: item.label, url: item.url, number: "↗", target: item.target });
	navUrls.add(url);
}
const activeNavUrl = currentPath === "/" ? "/"
	: currentPath === "/posts" || currentPath.startsWith("/posts/") || currentPath.startsWith("/category/") || currentPath.startsWith("/tag/") ? "/posts"
	: currentPath === "/gallery" || currentPath.startsWith("/gallery/") ? "/gallery"
	: navItems.find((item) => normalizeUrl(item.url) === currentPath)?.url
		?? (/^\/[^/]+$/.test(currentPath) && currentPath !== "/404" ? "/pages" : null);
const hidePanelBrand = ["/posts", "/pages", "/about", "/gallery"].includes(currentPath)
	|| currentPath.startsWith("/posts/")
	|| (/^\/[^/]+$/.test(currentPath) && !["/gallery", "/404"].includes(currentPath));

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const pageNumbers: Record<string, string> = {
	"/": "100",
	"/posts": "200",
	"/gallery": "300",
	"/pages": "500",
	"/about": "501",
};
const pageNumber = pageNumbers[currentPath] ?? null;
const sectionName = currentPath === "/posts" ? "ARCHIVE / ARTICLES" : currentPath === "/pages" ? "DIRECTORY / PAGES" : currentPath === "/gallery" ? "GALLERY" : "READING ROOM";
const now = new Date();
const serviceClock = formatServiceClock(now);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#fffef7" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=VT323&family=Noto+Sans+JP:wght@400;600&display=swap" rel="stylesheet" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

        <a class="skip-link" href="#main">本文へ移動</a>
        <div class="site-shell">
            <div class="service-meta">
                <span class="service-label">NETPRINT</span>
                <time class="service-clock" datetime={now.toISOString()} title="日本標準時（JST）" data-service-clock>
                    <span data-service-date>{serviceClock.date}</span>
                    <span data-service-time>{serviceClock.time}</span>
                </time>
            </div>
            <header class="masthead">
                <div class="masthead-brand">
                    <a class="brand" href="/" aria-label={`${siteTitle} home`}><TeletextLogo label={siteTitle} /></a>
                </div>
            </header>
            <nav class="site-nav" aria-label="メインナビゲーション">
                {navItems.map((item) => <a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined} data-section={item.number} aria-label={`${item.number} ${item.label}`} aria-current={activeNavUrl && normalizeUrl(item.url) === normalizeUrl(activeNavUrl) ? "page" : undefined}><b>{item.number}</b><span>{item.label}</span></a>)}
            </nav>
            <main id="main">
                {layout === "home" ? <slot /> : <section class="tele-panel reading-panel">
                    {!hidePanelBrand && <div class="panel-meta"><a href="/">THE INTERNET</a></div>}
                    {sectionName !== "READING ROOM" && <div class="section-banner" data-section={pageNumber}>{pageNumber && <span class="section-number">{pageNumber}</span>}<span>{sectionName}</span></div>}
                    <div class:list={["page-content", narrow && "page-content-narrow"]}>{["/posts", "/pages", "/gallery"].includes(currentPath) && <h1 class="sr-only">{title}</h1>}<slot /></div>
                    <div class="panel-bottom"><a href="/">← INDEX</a>{currentPath === '/gallery' && status && <span>{status}</span>}{pageNumber && <span>{pageNumber}</span>}</div>
                </section>}
            </main>
            <footer class="site-footer">
                <div class="footer-top">
                    <a href="/" class="footer-brand"><TeletextLogo label={siteTitle} /></a>
                    <span class="color-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                </div>
            </footer>
        </div>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<script>
	import { formatServiceClock } from "../utils/service-clock";

	const clock = document.querySelector<HTMLTimeElement>("[data-service-clock]");
	const dateLabel = clock?.querySelector("[data-service-date]");
	const timeLabel = clock?.querySelector("[data-service-time]");
	if (clock && dateLabel && timeLabel) {
		const update = () => {
			const now = new Date();
			const formatted = formatServiceClock(now);
			clock.dateTime = now.toISOString();
			dateLabel.textContent = formatted.date;
			timeLabel.textContent = formatted.time;
		};
		update();
		window.setInterval(update, 1000);
	}
</script>
