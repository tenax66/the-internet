---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import TeletextLogo from "../components/TeletextLogo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/teletext.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** トップの複数パネル、または下層の読み物レイアウト */
	layout?: "home" | "page";
	status?: string;
	/** 本文を読みやすい幅で中央寄せする（記事・固定ページ向け） */
	narrow?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	layout = "page",
	status = "",
	narrow = false,
} = Astro.props;

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const hidePanelBrand = ["/posts", "/pages", "/about", "/gallery"].includes(currentPath)
	|| currentPath.startsWith("/posts/")
	|| (/^\/[^/]+$/.test(currentPath) && !["/gallery", "/404"].includes(currentPath));

/*
 * 画面上部のバーに並べるナビ。
 * ブログの主要機能（ホーム / 記事一覧 / ページ一覧）は常に出し、そのうしろに
 * emdash の primary メニューで足された項目を並べる。URL が重なったものは省く。
 */
const normalizeUrl = (url: string) => url.replace(/\/$/, "") || "/";

const builtinNav: { label: string; url: string }[] = [
	{ label: "HOME", url: "/" },
	{ label: "ARTICLES", url: "/posts" },
	{ label: "PAGES", url: "/pages" },
];
const builtinUrls = new Set(builtinNav.map((i) => normalizeUrl(i.url)));

const menuItems = (menu?.items ?? [])
	.map((item) => ({
		label: normalizeUrl(item.url) === "/about" ? "ABOUT" : item.label,
		url: item.url,
		target: item.target ?? null,
	}))
	.filter((item) => !builtinUrls.has(normalizeUrl(item.url)));

const navItems: { label: string; url: string; target?: string | null }[] = [
	...builtinNav,
	...menuItems.filter((item) => normalizeUrl(item.url) !== "/gallery"),
	{ label: "GALLERY", url: "/gallery" },
];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const pageNumbers: Record<string, string> = {
	"/": "100",
	"/posts": "200",
	"/gallery": "300",
	"/pages": "500",
	"/about": "501",
};
const pageNumber = pageNumbers[currentPath] ?? null;
const sectionName = currentPath === "/posts" ? "ARCHIVE / ARTICLES" : currentPath === "/pages" ? "DIRECTORY / PAGES" : currentPath === "/gallery" ? "GALLERY" : "READING ROOM";
const navNumbers: Record<string, string> = { "/": "100", "/posts": "200", "/gallery": "300", "/pages": "500", "/about": "501" };
navItems.sort((a, b) => {
	const aNumber = Number(navNumbers[normalizeUrl(a.url)] ?? Number.MAX_SAFE_INTEGER);
	const bNumber = Number(navNumbers[normalizeUrl(b.url)] ?? Number.MAX_SAFE_INTEGER);
	return aNumber - bNumber;
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#fffef7" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=VT323&family=Noto+Sans+JP:wght@400;600&display=swap" rel="stylesheet" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

        <a class="skip-link" href="#main">本文へ移動</a>
        <div class="site-shell">
            <header class="masthead">
                <div class="masthead-brand">
                    <a class="brand" href="/" aria-label={`${siteTitle} home`}><TeletextLogo label={siteTitle} /></a>
                </div>
            </header>
            <nav class="site-nav" aria-label="メインナビゲーション">
                {navItems.map(item => <a href={item.url} target={item.target} aria-current={currentPath === normalizeUrl(item.url) ? "page" : undefined}><span>{navNumbers[normalizeUrl(item.url)] ?? "↗"}</span> {item.label}</a>)}
            </nav>
            <main id="main">
                {layout === "home" ? <slot /> : <section class="tele-panel reading-panel">
                    {!hidePanelBrand && <div class="panel-meta"><a href="/">THE INTERNET</a></div>}
                    {sectionName !== "READING ROOM" && <div class="section-banner">{pageNumber && <span class="section-number">{pageNumber}</span>}<span>{sectionName}</span></div>}
                    <div class:list={["page-content", narrow && "page-content-narrow"]}>{["/posts", "/pages", "/gallery"].includes(currentPath) && <h1 class="sr-only">{title}</h1>}<slot /></div>
                    <div class="panel-bottom"><a href="/">← INDEX</a>{currentPath === '/gallery' && status && <span>{status}</span>}{pageNumber && <span>{pageNumber}</span>}</div>
                </section>}
            </main>
            <footer class="site-footer">
                <a href="/" class="footer-brand"><TeletextLogo label={siteTitle} /></a>
                <p></p>
                <span class="color-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            </footer>
        </div>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
