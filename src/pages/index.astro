---
import { getEmDashCollection, getEmDashEntry, getSiteSettings, getTaxonomyTerms } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TeletextLogo from "../components/TeletextLogo.astro";
import TeletextGlobe from "../components/TeletextGlobe.astro";
import { getGallery, galleryImage } from "../utils/gallery";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
const { entries: posts, cacheHint } = await getEmDashCollection("posts", { orderBy: { published_at: "desc" } });
const { entries: pages, cacheHint: pagesCacheHint } = await getEmDashCollection("pages");
const { entry: about, cacheHint: aboutCacheHint } = await getEmDashEntry("pages", "about");
const { entries: artwork, cacheHint: galleryCacheHint } = await getGallery(undefined, 1);
const categories = await getTaxonomyTerms("category").catch(() => []);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
if (Astro.cache?.enabled) Astro.cache.set({ tags: [...(cacheHint.tags ?? []), ...(pagesCacheHint.tags ?? []), ...(aboutCacheHint.tags ?? []), ...(galleryCacheHint.tags ?? [])] });
const recent = posts.slice(0, 8);
const latest = posts[0];
const art = artwork[0]?.data.image;
const artUrl = galleryImage(art);
const dateFormat = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" });
const sections = [ { number: '100', title: 'INDEX', label: 'HOME', href: '/' }, { number: '200', title: 'ARTICLE', label: 'ARTICLES', href: '/posts' }, { number: '300', title: 'GALLERY', label: 'GALLERY', href: '/gallery' }, { number: '500', title: 'PAGES', label: 'PAGES', href: '/pages' } ];
---
<Base title={siteTitle} description={siteTagline} layout="home">
 <h1 class="sr-only">{siteTitle}</h1>
 <div class="home-grid">
  <section class="tele-panel index-panel" aria-label="サイト目次">
   <div class="panel-meta"><span>100</span></div>
   <div class="index-sign"><TeletextLogo label={siteTitle} /><p>NETPRINT</p></div>
   <div class="index-body">
    <nav class="index-links" aria-label="目次">{sections.map((section, i) => <a href={section.href} class:list={[i === 0 && 'selected']}><b>{section.number}</b><span>{section.title}</span><span class="leader" aria-hidden="true"></span></a>)}{about && <a href="/about"><b>501</b><span>ABOUT</span><span class="leader" aria-hidden="true"></span></a>}</nav>
    <div class="globe-caption"><TeletextGlobe /><span>GLOBAL<br />COMMUNICATION</span></div>
   </div>
   <div class="ticker"><span>*** HOME ***</span></div>
  </section>
  <section class="tele-panel latest-panel" id="latest">
   <div class="panel-meta"><span>200</span></div>
   <h2 class="color-heading cyan">LATEST ARTICLES</h2>
   <ol class="latest-list">{recent.map((post) => <li><a href={`/posts/${post.id}`}><span class="latest-title">{post.data.title}</span></a></li>)}</ol>
   {recent.length === 0 && <p class="empty-state">まだ記事がありません。<br />次の更新をお楽しみに。</p>}
   <a class="strip-link" href="/posts">READ ALL ARTICLES →</a>
  </section>
  <section class="tele-panel gallery-panel">
   <div class="panel-meta"><span>300</span></div>
   <h2 class="color-heading magenta">GALLERY</h2>
   <a class="gallery-preview" href="/gallery">{art && artUrl ? <img src={artUrl} alt={art.alt || '最新のドット絵'} width={art.width} height={art.height} /> : <div class="gallery-placeholder" aria-hidden="true">▟ ▚ ▙<br />▚ ▟ ▞<br />▙ ▞ ▟</div>}</a>
   <a class="text-link" href="/gallery">VIEW GALLERY →</a>
  </section>
  <section class="tele-panel feature-panel">
   <div class="panel-meta"><span>201</span></div>
   <h2 class="color-heading feature-heading"><span>FEATURED</span>PICK OF THE LATEST</h2>
   {latest && <article class="feature-article">
    <div class="feature-copy"><p class="eyebrow">LATEST ENTRY</p><h3><a href={`/posts/${latest.id}`}>{latest.data.title}</a></h3>{latest.data.excerpt ? <p>{latest.data.excerpt}</p> : <div class="feature-excerpt"><PortableText value={latest.data.content} /></div>}</div>
    {latest.data.featured_image && <a class="feature-image" href={`/posts/${latest.id}`} aria-label={latest.data.title}><Image image={latest.data.featured_image} width={640} /></a>}
    <div class="feature-foot">{latest.data.publishedAt && <time datetime={latest.data.publishedAt.toISOString()}>{dateFormat.format(latest.data.publishedAt)}</time>}<a href={`/posts/${latest.id}`}>READ MORE →</a></div>
   </article>}
  </section>
  <aside class="home-sidebar">
   <section class="tele-panel about-panel">
    <div class="panel-meta"><span>501</span></div>
    <h2 class="color-heading yellow">A SMALLER INTERNET</h2>
    {about ? <div class="about-excerpt"><PortableText value={about.data.content} /></div> : <p class="about-excerpt">{siteTagline}</p>}
    <a class="text-link" href={about ? '/about' : '/pages'}>{about ? 'ABOUT THIS SITE' : 'PAGES'} →</a>
   </section>
   <section class="tele-panel directory-panel">
    <div class="panel-meta"><span>500</span></div>
    <h2 class="color-heading green">PAGE DIRECTORY</h2>
    <div class="directory-links">{pages.map((page) => <a href={`/${page.id}`}>{page.data.title}<b>↗</b></a>)}</div>
    {categories.length > 0 && <div class="category-links"><p class="eyebrow">FILED UNDER</p>{categories.map(category => <a href={`/category/${category.slug}`}>{category.label} ↗</a>)}</div>}
    {pages.length === 0 && <a class="text-link" href="/posts">EXPLORE ARTICLES →</a>}
   </section>
  </aside>
  <section class="tele-panel elsewhere-panel">
   <div class="panel-meta"><span>888</span></div>
   <div class="elsewhere-content"><p>ENJOY YOUR<br /><strong>TELECOMMUNICATIONS.</strong></p><a href="https://archive.org/">INTERNET ARCHIVE ↗</a><a href="https://neocities.org/">NEOCITIES ↗</a><a href="https://github.com/tenax66">GITHUB ↗</a><span class="pixel-pattern" aria-hidden="true">▚▞▚▞</span></div>
  </section>
 </div>
</Base>
