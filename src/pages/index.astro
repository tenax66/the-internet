---
import {
	getEmDashCollection,
	getEmDashEntry,
	getSiteSettings,
	getTaxonomyTerms,
	getTermsForEntries,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Window from "../components/Window.astro";
import Icon from "../components/Icon.astro";
import PixelArt from "../components/PixelArt.astro";
import MyComputerWindow from "../components/desktop/MyComputerWindow.astro";
import ControlPanelWindow from "../components/desktop/ControlPanelWindow.astro";
import NotepadWindow from "../components/desktop/NotepadWindow.astro";
import LinksWindow from "../components/desktop/LinksWindow.astro";
import MediaPlayerWindow from "../components/desktop/MediaPlayerWindow.astro";
import CommandPromptWindow from "../components/desktop/CommandPromptWindow.astro";
import SolitaireWindow from "../components/desktop/SolitaireWindow.astro";
import NoLongerExistsWindow from "../components/desktop/NoLongerExistsWindow.astro";
import {
	BROWSER_NAME,
	resolveStarterSiteIdentity,
} from "../utils/site-identity";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);

/** 「このサイトについて」ウィンドウ。about ページが無ければ差し込み文を出す */
const { entry: about } = await getEmDashEntry("pages", "about");

/** マイ コンピュータ窓のページ数と、システムのプロパティ窓のカウント用 */
const { entries: pages } = await getEmDashCollection("pages");

/*
 * タグ / カテゴリはタクソノミが未定義だと投げるので、無ければ空扱いにする。
 * （コントロール パネル窓とマイ コンピュータ窓はどちらも空なら中身を出さない）
 */
const [tags, categories] = await Promise.all([
	getTaxonomyTerms("tag").catch(() => []),
	getTaxonomyTerms("category").catch(() => []),
]);

const recent = posts.slice(0, 8);
const tagsByEntry = await getTermsForEntries(
	"posts",
	recent.map((p) => p.data.id),
	"tag",
);

/** メモ帳（更新履歴）に流し込む行 */
const changelog = posts.slice(0, 12).map((p) => ({
	title: p.data.title,
	href: `/posts/${p.id}`,
	date: p.data.publishedAt ?? null,
}));

/** 「お気に入り」窓に出す外部リンク。ここを書き換えれば中身が変わる */
const favorites = [
	{ label: "Internet Archive", url: "https://archive.org/", note: "web" },
	{ label: "Neocities", url: "https://neocities.org/", note: "web" },
	{ label: "GitHub", url: "https://github.com/tenax66", note: "code" },
];

const dateFormat = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});

/**
 * 一覧系の窓は中身の件数で高さを決める。記事が 1 本しか無いのに
 * 高さだけ確保すると、白い空白がそのまま見えてしまうため。
 */
const clampRow = (n: number, min: number, max: number) =>
	Math.max(min, Math.min(max, n));
const postsRow = clampRow(11 + recent.length * 4, 15, 43);
const notepadRow = clampRow(9 + changelog.length * 3, 13, 33);
---

<Base title={siteTitle} description={siteTagline} chrome="desktop">
	{/*
	 * 窓が乱立するのはこのトップページだけ。下層ページは 1 枚の窓になる。
	 *
	 * 窓は .desktop-grid の直下に並べる。並び順 = モバイルでの縦積み順なので、
	 * 大事なものから書く。広い画面での配置は各窓の col / row（grid の span）と
	 * grid-auto-flow: dense に任せる。
	 */}
	<div class="desktop-grid">
		{/* ---------------------------------------------- 看板ウィンドウ */}
		<Window
			id="main"
			class="area-main"
			icon="document"
			title={`${siteTitle} - ${siteTagline}`}
			closable={false}
			col={2}
			row={37}
		>
			<div class="signboard">
				<h1 class="signboard-title">{siteTitle}</h1>
				<p class="signboard-tagline">{siteTagline}</p>
			</div>
		</Window>

		{/* -------------------------------------------------- 最新記事 */}
		<Window
			id="posts"
			class="area-posts"
			icon="folder-open"
			title="最新記事"
			bodyClass="win-body-flush"
			col={2}
			row={postsRow}
		>
			<div class="win-scroll">
				{
					recent.length === 0 ? (
						<p class="listview-empty">
							まだ記事がありません。
							<a href="/_emdash/admin/content/posts/new">1 本目を書く</a>
						</p>
					) : (
						<div class="listview">
							{recent.map((post) => {
								const postTags = tagsByEntry.get(post.data.id) ?? [];
								return (
									<a class="listview-row" href={`/posts/${post.id}`}>
										<Icon name="document" class="listview-icon" />
										<span class="listview-name">{post.data.title}</span>
										<span class="listview-meta">
											{post.data.publishedAt
												? dateFormat.format(post.data.publishedAt)
												: "下書き"}
										</span>
										<span class="listview-meta listview-meta-extra">
											{postTags.length > 0
												? postTags.map((t) => t.label).join(", ")
												: "—"}
										</span>
									</a>
								);
							})}
						</div>
					)
				}
			</div>
		</Window>

		{/* ---------------------------------------- このサイトについて */}
		<Window
			id="about"
			class="area-about"
			icon="browser"
			title={`${about?.data.title ?? "このサイトについて"} - ${BROWSER_NAME}`}
			col={2}
			row={23}
		>
			<div class="prose">
				{
					about ? (
						<PortableText value={about.data.content} />
					) : (
						<p>
							about ページがまだありません。
							<a href="/_emdash/admin/content/pages/new">管理画面から作成</a>
							すると、ここに本文が表示されます。
						</p>
					)
				}
			</div>

			<div class="row" style="margin-top:14px">
				{about && <a class="btn" href="/about">続きを読む</a>}
				<a class="btn" href="/pages">ページ一覧</a>
			</div>
		</Window>

		{/* ------------------------------------------ マイ コンピュータ */}
		<MyComputerWindow
			postCount={posts.length}
			pageCount={pages.length}
			categories={categories}
			col={1}
			row={27}
		/>

		{/* ---------------------------------------- コントロール パネル */}
		<ControlPanelWindow tags={tags} col={1} row={19} />

		{/* -------------------------------------------------- ドット絵 */}
		<Window
			id="paint"
			class="area-paint"
			icon="paint"
			title="drive_my_car.bmp - ペイント"
			bodyClass="win-body-face"
			col={1}
			row={50}
			fit
		>
			<div class="paint">
				<div class="paint-tools" aria-hidden="true">
					{Array.from({ length: 16 }).map(() => <span class="paint-tool" />)}
				</div>
				<div class="paint-canvas">
					<PixelArt />
				</div>
			</div>
		</Window>

		{/* -------------------------------------------------- 更新履歴 */}
		<NotepadWindow entries={changelog} col={1} row={notepadRow} />

		{/* -------------------------------------------------- ソリティア */}
		<SolitaireWindow col={1} row={25} />

		{/* -------------------------------------------------- お気に入り */}
		<LinksWindow links={favorites} col={1} row={17} />

		{/* ------------------------------------------------- 飾りの窓たち */}
		<NoLongerExistsWindow col={1} row={24} />
		<MediaPlayerWindow col={1} row={24} />
		<CommandPromptWindow col={1} row={32} />
	</div>
</Base>
