---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getGallery, galleryImage } from "../utils/gallery";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
const { entries: posts, cacheHint } = await getEmDashCollection("posts", { orderBy: { published_at: "desc" } });
const { entries: pages, cacheHint: pagesCacheHint } = await getEmDashCollection("pages");
const { entry: about, cacheHint: aboutCacheHint } = await getEmDashEntry("pages", "about");
const { entries: artwork, cacheHint: galleryCacheHint } = await getGallery(undefined, 1);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
if (Astro.cache?.enabled) Astro.cache.set({ tags: [...(cacheHint.tags ?? []), ...(pagesCacheHint.tags ?? []), ...(aboutCacheHint.tags ?? []), ...(galleryCacheHint.tags ?? [])] });
const recent = posts.slice(0, 5);
const latest = posts[0];
const art = artwork[0]?.data.image;
const artUrl = galleryImage(art);
const dateFormat = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" });
const directoryPages = pages.filter(page => page.id !== "about");
---
<Base title={siteTitle} description={siteTagline} layout="home">
 <h1 class="sr-only">{siteTitle}</h1>
 <div class="home-grid">
  <div class="home-main">
  <section class="tele-panel feature-panel">
   <h2 class="color-heading feature-heading"><span>JUST IN</span>LATEST NETPRINTS</h2>
   {latest && <article class="feature-article">
    <div class="feature-copy"><h3><a href={`/posts/${latest.id}`}>{latest.data.title}</a></h3>{latest.data.excerpt ? <p>{latest.data.excerpt}</p> : <div class="feature-excerpt"><PortableText value={latest.data.content} /></div>}</div>
    {latest.data.featured_image && <a class="feature-image" href={`/posts/${latest.id}`} aria-label={latest.data.title}><Image image={latest.data.featured_image} width={640} /></a>}
    <div class="feature-foot">{latest.data.publishedAt && <time datetime={latest.data.publishedAt.toISOString()}>{dateFormat.format(latest.data.publishedAt)}</time>}<a href={`/posts/${latest.id}`}>READ MORE →</a></div>
   </article>}
   {!latest && <p class="empty-state">まだ記事がありません。</p>}
  </section>
   {recent.length > 0 && <>
  <section class="tele-panel latest-panel" id="latest">
   <h2 class="color-heading cyan">ARTICLES</h2>
   <ol class="latest-list">{recent.map((post) => <li><a href={`/posts/${post.id}`}><span class="latest-title">{post.data.title}</span></a></li>)}</ol>
   <a class="strip-link" href="/posts">READ ALL ARTICLES →</a>
  </section>
   </>}
  </div>
  <aside class="home-sidebar">
  <section class="tele-panel gallery-panel">
   <h2 class="color-heading magenta">GALLERY</h2>
   <a class="gallery-preview" href="/gallery" aria-label="GALLERY">{art && artUrl ? <img src={artUrl} alt={art.alt || '最新のドット絵'} width={art.width} height={art.height} /> : <div class="gallery-placeholder" aria-hidden="true">▟ ▚ ▙<br />▚ ▟ ▞<br />▙ ▞ ▟</div>}</a>
   <a class="text-link" href="/gallery">VIEW GALLERY →</a>
  </section>
   <section class="tele-panel about-panel">
    <h2 class="color-heading yellow">ABOUT THE INTERNET</h2>
    {about ? <div class="about-excerpt"><PortableText value={about.data.content} /></div> : <p class="about-excerpt">{siteTagline}</p>}
    <a class="text-link" href={about ? '/about' : '/pages'}>{about ? 'ABOUT THIS SITE' : 'PAGES'} →</a>
   </section>
  </aside>
 </div>
 {directoryPages.length > 0 && <div class="home-utility">
   <section class="tele-panel directory-panel">
    <h2 class="color-heading green">PAGE DIRECTORY</h2>
    <div class="directory-links">{directoryPages.map((page) => <a href={`/${page.id}`}>{page.data.title}<b>↗</b></a>)}</div>
   </section>
 </div>}
</Base>
