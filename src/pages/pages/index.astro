---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

// 固定ページの一覧。/:slug で個別ページに飛ぶ
const { entries: pages, cacheHint } = await getEmDashCollection("pages", {});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const sorted = [...pages].sort((a, b) =>
	String(a.data.title).localeCompare(String(b.data.title), "ja"),
);
---

<Base
	title="ページ一覧"
	description="このサイトの固定ページ一覧"
	status={`${pages.length} 個のオブジェクト`}
>
	{
		sorted.length === 0 ? (
			<p class="listview-empty">まだページがありません。</p>
		) : (
			<ul class="post-grid page-grid">
				{sorted.map((page) => (
					<li class="post-card page-card">
						<a class="post-card-media post-card-media-empty page-card-media" href={`/${page.id}`} tabindex="-1" aria-hidden="true">
							<svg class="page-card-icon" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges" fill="currentColor">
								<path fill-rule="evenodd" d="M1 3h5l2 2h7v10H1zM3 7v6h10V7H7L5 5H3z" />
								<path d="M4 9h8v1H4zm0 2h6v1H4z" />
							</svg>
						</a>
						<div class="post-card-body">
							<h2 class="post-card-title"><a href={`/${page.id}`}>{page.data.title}</a></h2>
							<p class="post-card-meta">/{page.id}</p>
						</div>
					</li>
				))}
			</ul>
		)
	}
</Base>
